{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-16/server.schema.json",
  "name": "io.github.martimy/batfish-q-mcp",
  "description": "An MCP server exposing Batfish tools so AI assistants can query network configs in plain language.",
  "repository": {
    "url": "https://github.com/martimy/batfish-q-mcp",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "batfish-q-mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Host of the Batfish server (default 127.0.0.1)",
          "isRequired": false,
         "name": "BATFISH_SERVER"
        }
      ]
    }
  ]
}
